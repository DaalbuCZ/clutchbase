# Generate independent random values; do not commit .env.
# Example: openssl rand -hex 32
CLUTCHBASE_ADMIN_TOKEN=
POSTGRES_PASSWORD=
# For running the API outside Compose; replace YOUR_PASSWORD below.
DATABASE_URL=postgres://clutchbase:YOUR_PASSWORD@127.0.0.1:5432/clutchbase?sslmode=disable

# Exact browser origin for Steam callbacks; HTTPS is required outside loopback.
# Vite development uses :5173; the Compose/API-served build uses :8080.
CLUTCHBASE_ORIGIN=http://127.0.0.1:8080
