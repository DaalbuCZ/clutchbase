<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.3.15</Version>
  </PropertyGroup>
  <ItemGroup>
    <None Update="presets.version" CopyToOutputDirectory="PreserveNewest" />
    <None Update="mode-control.version" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="$(CounterStrikeSharpDir)/*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireCounterStrikeSharp" BeforeTargets="ResolveReferences"
          Condition="!Exists('$(CounterStrikeSharpDir)/CounterStrikeSharp.API.dll')">
    <Error Text="Set CounterStrikeSharpDir to the api directory from the pinned CounterStrikeSharp 1.0.378 release." />
  </Target>
</Project>
